# joyjoy backend - example env. Copy to .env and fill in real values.
# Never commit .env. Keep generated secrets stable once the app has data.

# =====================================================================
# The TWO switches that drive everything
# =====================================================================
# DEV_MODE — auth STRICTNESS only (not infra):
#   true  → dev-relaxed: no-auth X-User-Id header + auto dev user, insecure cookie,
#           password-reset OTP logged (not emailed), MEDIA_DEV_EXTRA_ROOTS honored.
#   false → strict: real session-cookie / JWT auth required.
DEV_MODE=true

# COMPOSE_PROFILES — the SINGLE source of truth for what runs AND how the backend
# self-configures (db backend + sandbox + observability all derive from this; there
# are NO separate SANDBOX_ENABLED / METRICS_ENABLED / TRACING_ENABLED flags):
#   Database (pick ONE, or none):
#     localdb        → bundled Postgres 16 container (creates joyjoy_db + langgraph_db)
#     devdb          → no Postgres; local SQLite (app DB + LangGraph checkpointer)
#     (neither)      → external Postgres from the DB_* vars below ("server" mode)
#   Add-ons (combine freely):
#     sandbox        → OpenSandbox per-session code/shell execution tier
#     observability  → Langfuse tracing + Prometheus/Grafana metrics
# Examples:
#   COMPOSE_PROFILES=devdb                                (zero external deps)
#   COMPOSE_PROFILES=localdb,sandbox,observability        (full local stack)
#   COMPOSE_PROFILES=sandbox                              (external Postgres + sandbox)
COMPOSE_PROFILES=devdb

# ---- Runtime ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# ---- Gateway/dev identity ----
GATEWAY_API_KEY=
USER_ID_HEADER=X-User-Id
THREAD_ID_HEADER=X-Thread-Id
DEV_USERNAME=dev-user

# ---- Auth: session cookie + password-reset OTP ----
JWT_SECRET=
JWT_ALGORITHMS=HS256
JWT_AUDIENCE=
SESSION_COOKIE=joyjoy_session
SESSION_TTL_HOURS=720
OTP_TTL_MINUTES=10
APP_PUBLIC_NAME=joyjoy

# ---- SMTP (optional; unset logs OTPs in dev instead of emailing) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---- Postgres (used when COMPOSE_PROFILES is `localdb` or has neither localdb/devdb) ----
# Two SEPARATE databases on the same server: the relational app DB (APP_DB_NAME) and
# the LangGraph checkpointer/store DB (LANGGRAPH_CHECKPOINT_DB).
#   • localdb : leave DB_* blank → the bundled container uses joyjoy/joyjoy and both
#               databases are created for you on first init.
#   • server  : set ALL of DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD to your Postgres,
#               and make sure BOTH databases already exist on it.
#   • devdb   : ignored (SQLite instead).
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
APP_DB_NAME=joyjoy_db
LANGGRAPH_CHECKPOINT_DB=langgraph_db
PG_POOL_MAX=20
JOYJOY_INTERRUPT_TOOLS=

# ---- Dev local persistence (COMPOSE_PROFILES=devdb; host/no-docker dev only — these
#      are NOT read by the baked docker-compose.yml stack, see CONTAINER_DATA_DIR below) ----
SQLITE_CHECKPOINT_PATH=./data/dev_checkpoints.sqlite
USER_DATA_ROOT=./data/users
APP_DB_PATH=./data/joyjoy.db
WORKSPACE_ROOT=./data/workspaces

# ---- Baked stack persistence mount (docker-compose.yml only) ----
# Where the backend CONTAINER's workspace files + devdb SQLite files live, all on one
# named volume. Only change this if you also relocate the volume mount in
# docker-compose.yml to match — the two must always agree.
CONTAINER_DATA_DIR=/data
# DEV-ONLY: extra allow-list roots for serving absolute MEDIA: paths outside the
# workspace (comma-separated; ~ expanded). Ignored when DEV_MODE=false. Empty = workspace only.
# Example (WSL+Windows): MEDIA_DEV_EXTRA_ROOTS=~,/mnt/c/Users
MEDIA_DEV_EXTRA_ROOTS=

# ---- Skills / MCP ----
# Global skills and MCP servers are seeded into the DB from global_seed.sql.
# MCP secrets should be referenced as ${VAR} in DB rows; real values live here.

# ---- Azure OpenAI base-model API key ----
# The seeded global/base models reference ${AZURE_OPENAI_API_KEY} at runtime.
AZURE_OPENAI_API_KEY=

# Optional legacy Azure fallback settings.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=o4-mini
AZURE_OPENAI_MODEL=o4-mini

# Optional legacy model catalog settings; current global models live in the DB.
JOYJOY_MODELS_JSON=
JOYJOY_GLOBAL_MODELS=

# ---- Optional provider fallback credentials ----
# Used only when a Bedrock model has no per-model AWS keys configured.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ---- Optional tools ----
TAVILY_API_KEY=

# ---- Credentials table encryption ----
# Fernet key. Generate once and keep stable; rotating it orphans encrypted secrets.
CREDENTIAL_ENCRYPTION_KEY=

# ---- OpenSandbox connection details (only used when COMPOSE_PROFILES=sandbox) ----
# The `sandbox` profile IS the on/off switch — no SANDBOX_ENABLED flag. These are just
# the connection details for when it's active.
#   • docker-compose.yml (baked stack): backend reaches the server by service name →
#     SANDBOX_SERVER_DOMAIN=opensandbox:8090, SANDBOX_USE_SERVER_PROXY=true.
#   • host dev path (docker-compose.dev.yml or scripts/start_all.sh): server on the
#     host → SANDBOX_SERVER_DOMAIN=127.0.0.1:8090, SANDBOX_USE_SERVER_PROXY=false.
OPENSANDBOX_API_KEY=
SANDBOX_SERVER_DOMAIN=127.0.0.1:8090
SANDBOX_SERVER_PROTOCOL=http
SANDBOX_USE_SERVER_PROXY=false
SANDBOX_IMAGE=joyjoy/sandbox-fat:4
SANDBOX_CPU=1
SANDBOX_MEMORY=2Gi
SANDBOX_TIMEOUT_MINUTES=30
SANDBOX_IDLE_MINUTES=15
SANDBOX_MAX_LIVE=16
SANDBOX_VOLUME_PREFIX=joyjoy-ws-
SANDBOX_MOUNT_PATH=/workspace

# ---- Observability connection details (only used when COMPOSE_PROFILES=observability) ----
# The `observability` profile auto-enables the backend's metrics + tracing — no
# METRICS_ENABLED / TRACING_ENABLED flags. Below are just the transport details.
OTEL_SERVICE_NAME=joyjoy-backend
# (A) PREFERRED — Langfuse LangChain callback. NATIVE per-user + per-session views. With
#     the `observability` profile these keys auto-provision the Langfuse project on first
#     boot (LANGFUSE_INIT_*), so the dev defaults work out of the box; rotate for prod.
#     UI login (:3000) = admin@joyjoy.local / joyjoyadmin (LANGFUSE_INIT_USER_*).
LANGFUSE_PUBLIC_KEY=pk-lf-joyjoy-dev
LANGFUSE_SECRET_KEY=sk-lf-joyjoy-dev
LANGFUSE_HOST=http://langfuse-web:3000   # host (docker-compose.dev.yml): http://localhost:3000
# (B) FALLBACK — vendor-neutral OTLP (Tempo/Jaeger too). Used only if the LANGFUSE_* keys
#     above are empty. Basic auth = base64(public_key:secret_key):
#       python -c "import base64;print(base64.b64encode(b'pk-lf-...:sk-lf-...').decode())"
# OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse-web:3000/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(public_key:secret_key)>

# ---- Self-hosted Langfuse stack (only used by COMPOSE_PROFILES=observability) ----
# Generated-once secrets for the bundled Langfuse services (web/worker/clickhouse/
# redis/minio/postgres). Keep stable once it has data.
LANGFUSE_DB_PASSWORD=langfuse
LANGFUSE_SALT=changeme-langfuse-salt
LANGFUSE_ENCRYPTION_KEY=                 # 64 hex chars: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=                # openssl rand -base64 32
LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
LANGFUSE_REDIS_PASSWORD=redis
LANGFUSE_MINIO_PASSWORD=miniosecret
# Grafana admin password for the bundled dashboards.
GRAFANA_ADMIN_PASSWORD=admin
